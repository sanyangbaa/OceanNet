# Database Configuration
# Dev (Local MySQL)
DATABASE_URL=database_url_here
DATABASE_SSL=false

# Authentication
JWT_SECRET=jwt_secret_code_here
ADMIN_USERNAME=admin_username_here
ADMIN_PASSWORD=admin_password_here

# App Environment
NODE_ENV="development"
VITE_API_BASE_URL="/api"

# Email (Resend) — get your API key from https://resend.com
RESEND_API_KEY=resend_api_key

RESEND_FROM_EMAIL="onboarding@resend.dev"

# Comma-separated admin emails that receive notifications
RESEND_TO_EMAILS=resend_to_email